{
	"name": "@cloudillo/calcillo-app",
	"version": "0.8.17",
	"private": true,
	"description": "Calcillo spreadsheet application",
	"type": "module",
	"main": "src/index.js",
	"scripts": {
		"l-scan": "i18next-scanner --config src/i18n/scanner.config.cjs",
		"ts": "tsgo --noEmit",
		"ts-test": "tsgo --noEmit -p tsconfig.test.json",
		"ts-watch": "tsgo --noEmit --watch",
		"build": "pnpm run ts && cross-env NODE_ENV=production node esbuild.config.js",
		"watch": "node esbuild.config.js --watch",
		"test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest",
		"test:watch": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest --watch",
		"test:coverage": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage",
		"clean": "rimraf .cache dist/assets-*"
	},
	"author": "Szilárd Hajba <szilu@cloudillo.org",
	"license": "LGPL-3.0-or-later",
	"devDependencies": {
		"@cloudillo/core": "workspace:^",
		"@cloudillo/crdt": "workspace:^",
		"@cloudillo/react": "workspace:^",
		"@fortune-sheet/core": "^1.0.4",
		"@fortune-sheet/react": "^1.0.4",
		"@symbion/opalui": "^0.14.10",
		"@symbion/runtype": "^1.2.1",
		"@types/debounce": "^1.2.4",
		"@types/jest": "^30.0.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/react-router-dom": "^5.3.3",
		"cross-env": "^10.1.0",
		"dayjs": "^1.11.21",
		"debounce": "^3.0.0",
		"esbuild": "^0.28.1",
		"i18next": "^26.3.6",
		"i18next-scanner": "^4.6.0",
		"i18next-scanner-typescript": "^1.2.1",
		"jest": "^30.4.2",
		"jotai": "^2.20.2",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-i18next": "^17.0.11",
		"react-icons": "^5.7.0",
		"react-router-dom": "^7.18.1",
		"react-yjs": "^2.0.1",
		"rimraf": "^6.1.3",
		"ts-jest": "^29.4.12",
		"tslib": "^2.8.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"y-indexeddb": "^9.0.12",
		"y-websocket": "^3.0.0",
		"yjs": "^13.6.31"
	},
	"dependencies": {
		"exceljs": "^4.4.0",
		"lib0": "^0.2.117"
	}
}
