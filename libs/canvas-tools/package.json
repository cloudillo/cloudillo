{
	"name": "@cloudillo/canvas-tools",
	"version": "0.8.22",
	"description": "SVG transform gizmos for React — rotation, pivot, and resize handles for building canvas editors",
	"keywords": [
		"cloudillo",
		"react",
		"svg",
		"canvas",
		"transform",
		"gizmo",
		"rotation",
		"resize",
		"editor"
	],
	"homepage": "https://cloudillo.org",
	"repository": {
		"type": "git",
		"url": "https://github.com/cloudillo/cloudillo.git",
		"directory": "libs/canvas-tools"
	},
	"bugs": {
		"url": "https://github.com/cloudillo/cloudillo/issues"
	},
	"type": "module",
	"main": "lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./components.css": "./lib/components.css"
	},
	"files": [
		"lib",
		"README.md"
	],
	"scripts": {
		"ts": "tsgo --noEmit",
		"ts-test": "tsgo --noEmit -p tsconfig.test.json",
		"test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest",
		"build": "tsgo && cp src/components.css lib/",
		"build-ts": "tsc && cp src/components.css lib/",
		"watch": "tsgo -w",
		"clean": "rimraf .cache lib*"
	},
	"author": "Szilárd Hajba <szilu@cloudillo.org>",
	"license": "MPL-2.0",
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@cloudillo/core": "workspace:^",
		"@cloudillo/react": "workspace:^",
		"react-svg-canvas": "^0.1.9"
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@types/react": "^19.3.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"rimraf": "^6.1.3",
		"ts-jest": "^29.4.15",
		"tslib": "^2.8.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	},
	"peerDependencies": {
		"react": "^19.1.0"
	}
}
