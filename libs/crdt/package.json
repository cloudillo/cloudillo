{
	"name": "@cloudillo/crdt",
	"version": "0.8.18",
	"description": "Yjs CRDT collaborative editing client for Cloudillo — IndexedDB persistence, awareness, and WebSocket sync",
	"keywords": [
		"cloudillo",
		"yjs",
		"crdt",
		"real-time",
		"collaborative-editing",
		"websocket",
		"y-indexeddb",
		"decentralized"
	],
	"homepage": "https://cloudillo.org",
	"repository": {
		"type": "git",
		"url": "https://github.com/cloudillo/cloudillo.git",
		"directory": "libs/crdt"
	},
	"bugs": {
		"url": "https://github.com/cloudillo/cloudillo/issues"
	},
	"type": "module",
	"main": "lib/index.js",
	"exports": {
		".": {
			"import": "./lib/index.js",
			"types": "./lib/index.d.ts"
		}
	},
	"files": [
		"lib",
		"README.md"
	],
	"scripts": {
		"ts": "tsgo --noEmit",
		"ts-test": "tsgo --noEmit -p tsconfig.test.json",
		"build": "tsgo",
		"build-ts": "tsc",
		"watch": "tsgo -w",
		"test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest",
		"test:watch": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --watch",
		"test:coverage": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage",
		"clean": "rimraf .cache lib*"
	},
	"author": "Szilárd Hajba <szilu@cloudillo.org>",
	"license": "LGPL-3.0-or-later",
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@cloudillo/core": "workspace:^",
		"y-protocols": "^1.0.7",
		"y-websocket": "3.1.0",
		"yjs": "^13.6.32"
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"jest": "^30.5.1",
		"lib0": "^0.2.117",
		"rimraf": "^6.1.3",
		"ts-jest": "^29.4.12",
		"tslib": "^2.8.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"y-indexeddb": "^9.0.12"
	}
}
