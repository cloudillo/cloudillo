{
	"name": "@cloudillo/fonts",
	"version": "0.8.22",
	"private": true,
	"description": "Curated open-source font collection for web apps — static TTF fonts with auto-download script",
	"keywords": [
		"cloudillo",
		"fonts",
		"web-fonts",
		"ttf",
		"google-fonts"
	],
	"homepage": "https://cloudillo.org",
	"repository": {
		"type": "git",
		"url": "https://github.com/cloudillo/cloudillo.git",
		"directory": "libs/fonts"
	},
	"bugs": {
		"url": "https://github.com/cloudillo/cloudillo/issues"
	},
	"author": "Szilárd Hajba <szilu@cloudillo.org>",
	"license": "MPL-2.0",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./font-files": "./src/font-files.ts",
		"./font-metrics": "./src/font-metrics.ts",
		"./metadata": "./src/metadata.ts",
		"./fonts.css": "./src/fonts.css"
	},
	"files": [
		"src",
		"fonts",
		"scripts",
		"README.md"
	],
	"scripts": {
		"postinstall": "node scripts/download-fonts.js",
		"download": "node scripts/download-fonts.js && node scripts/font-metrics.js",
		"download:force": "node scripts/download-fonts.js --force && node scripts/font-metrics.js",
		"metrics": "node scripts/font-metrics.js",
		"ts-test": "tsgo --noEmit -p tsconfig.test.json",
		"test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest",
		"test:watch": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --watch",
		"test:coverage": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage"
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@types/node": "^26.6.6",
		"@typescript/native": "npm:typescript@^7.0.2",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"ts-jest": "^29.4.15",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	}
}
