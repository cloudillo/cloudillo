{
	"name": "@cloudillo/types",
	"version": "0.8.20",
	"description": "Shared TypeScript types and runtype validators for Cloudillo — the open-source decentralized collaboration platform",
	"keywords": [
		"cloudillo",
		"types",
		"typescript",
		"runtype",
		"validation",
		"decentralized",
		"collaboration"
	],
	"homepage": "https://cloudillo.org",
	"repository": {
		"type": "git",
		"url": "https://github.com/cloudillo/cloudillo.git",
		"directory": "libs/types"
	},
	"bugs": {
		"url": "https://github.com/cloudillo/cloudillo/issues"
	},
	"type": "module",
	"main": "lib/types.js",
	"types": "lib/types.d.ts",
	"exports": {
		".": {
			"import": "./lib/types.js",
			"types": "./lib/types.d.ts"
		}
	},
	"files": [
		"lib",
		"README.md"
	],
	"scripts": {
		"ts": "tsgo --noEmit",
		"ts-test": "tsgo --noEmit -p tsconfig.test.json",
		"build": "tsgo",
		"build-ts": "tsc",
		"watch": "tsgo -w",
		"test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest",
		"test:watch": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --watch",
		"test:coverage": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage",
		"clean": "rimraf .cache lib*"
	},
	"author": "Szilárd Hajba <szilu@cloudillo.org>",
	"license": "LGPL-3.0-or-later",
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@symbion/runtype": "^1.3.1"
	},
	"devDependencies": {
		"@jest/globals": "^30.5.2",
		"@types/jest": "^30.0.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"jest": "^30.5.2",
		"rimraf": "^6.1.3",
		"ts-jest": "^29.4.14",
		"tslib": "^2.8.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	}
}
