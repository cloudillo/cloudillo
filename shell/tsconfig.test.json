{
	"extends": "./tsconfig.json",
	"include": ["src/**/*"],
	"exclude": [],
	"compilerOptions": {
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"types": ["jest"],
		// `webworker` on top of `dom` for the sw/ modules the suites reach into
		// (ServiceWorkerGlobalScope lives only in lib.webworker). The duplicate
		// declarations the two libs share are tolerated by the inherited
		// `skipLibCheck`.
		"lib": ["es2022", "dom", "dom.iterable", "webworker"]
	}
}
